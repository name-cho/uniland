// Консольная (без окна) версия приветствия: спрашивает имя и отвечает.
// Запуск:  uniland run examples/greet_cli.uni

let name = input("Введи своё имя: ")

if (length(trim(name)) == 0) {
    print("Имя пустое — ну и ладно, привет, незнакомец!")
} else {
    print(`Привет, {trim(name)}! Рад знакомству.`)
}

// можно спрашивать дальше — например, число
let age = input("Сколько тебе лет? ")
print(`Через год тебе будет {to_number(age) + 1}.`)
